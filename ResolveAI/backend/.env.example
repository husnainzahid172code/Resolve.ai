# ---------- LLM (agent planner) ----------
# auto = openai if OPENAI_API_KEY is set, else gemini if GOOGLE_API_KEY is set, else the OFFLINE demo planner
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Free key: https://aistudio.google.com/apikey  (free-tier Flash models; check current names in AI Studio)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried automatically if the main model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------- Business data ----------
# auto = google_sheets if both values below are set and the file exists, else local_demo
DATA_SOURCE=auto
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json
SHEETS_TIMEOUT_SECONDS=10
SHEETS_CACHE_SECONDS=30

# ---------- Customer email (Gmail) ----------
# auto = gmail if both values are set, else DEMO OUTBOX (emails recorded in the admin UI, not sent)
EMAIL_MODE=auto
GMAIL_ADDRESS=
# 16-character App Password from https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_APP_PASSWORD=
# Safe demo: deliver every customer email to this address instead of the fake demo customers
EMAIL_DEMO_RECIPIENT=

# ---------- Admin auth ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string
TOKEN_TTL_MINUTES=480

# ---------- Agent bounds ----------
MAX_AGENT_STEPS=12
MAX_REVISIONS=2
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
